# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# JWT secret for signing tokens - REQUIRED
JWT_SECRET=please_change_me_to_a_long_random_string

# Token expiration (e.g. 1h, 7d)
JWT_EXPIRES_IN=1d

# Database path override (optional). Default resolves to ../notes_database/data/notes.db
# SQLITE_DB_PATH=../notes_database/data/notes.db
